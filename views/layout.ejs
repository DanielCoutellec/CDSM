<!DOCTYPE html>
<html lang="fr">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= title %></title>

  <meta
    name="description"
    content="CDSM accompagne les entreprises dans leur transformation numérique avec des solutions simples, performantes et adaptées à leurs usages."
  >

  <link
    rel="stylesheet"
    href="/css/styles.css"
  >

</head>


<body>

  <!-- =========================================
       HEADER
  ========================================== -->

  <header class="site-header">

    <div class="container header-inner">

      <!-- LOGO -->

      <a
        href="/"
        class="logo"
        aria-label="CDSM - Accueil"
      >
        <img
          src="/images/logo-cdsm.png"
          alt="CDSM"
        >
      </a>


      <!-- MENU MOBILE -->

      <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mainNav"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>


      <!-- NAVIGATION -->

      <nav
        class="main-nav"
        id="mainNav"
      >

        <a
          href="/"
          class="<%= currentPath === '/' ? 'active' : '' %>"
        >
          Accueil
        </a>

        <a
          href="/qui-sommes-nous"
          class="<%= currentPath === '/qui-sommes-nous' ? 'active' : '' %>"
        >
          Qui sommes-nous ?
        </a>

        <a href="/#approche">
          Notre approche
        </a>

        <a
          href="/solutions"
          class="<%= currentPath === '/solutions' ? 'active' : '' %>"
        >
          Nos solutions
        </a>

        <a
          href="/references"
          class="<%= currentPath === '/references' ? 'active' : '' %>"
        >
          Références
        </a>

        <a
          href="/contact"
          class="<%= currentPath === '/contact' ? 'active' : '' %>"
        >
          Contact
        </a>

      </nav>

    </div>

  </header>


  <!-- =========================================
       CONTENU
  ========================================== -->

  <main>

    <%- body %>

  </main>


  <!-- =========================================
       FOOTER
  ========================================== -->

  <footer class="site-footer">

    <div class="container footer-grid">


      <!-- CDSM -->

      <div class="footer-brand">

        <div class="footer-brand-name">

          <span class="footer-diamond"></span>

          <strong>
            CDSM
          </strong>

        </div>

        <p>
          Solutions digitales pour les entreprises.
        </p>

        <p>
          CDSM accompagne les organisations dans leur
          transformation numérique avec des solutions
          simples, performantes et adaptées à leurs usages.
        </p>

      </div>


      <!-- NAVIGATION -->

      <div class="footer-column">

        <h3>
          Navigation
        </h3>

        <a href="/">
          Accueil
        </a>

        <a href="/qui-sommes-nous">
          Qui sommes-nous ?
        </a>

        <a href="/#approche">
          Notre approche
        </a>

        <a href="/solutions">
          Nos solutions
        </a>

        <a href="/references">
          Références
        </a>

        <a href="/contact">
          Contact
        </a>

      </div>


      <!-- INFORMATIONS -->

      <div class="footer-column">

        <h3>
          Informations
        </h3>

        <a href="/mentions-legales">
          Mentions légales
        </a>

        <a href="/confidentialite">
          Politique de confidentialité
        </a>

      </div>


      <!-- CONTACT -->

      <div class="footer-column">

        <h3>
          Contact
        </h3>

        <a href="/contact">
          Nous contacter
        </a>

      </div>

    </div>


    <!-- COPYRIGHT -->

    <div class="container footer-bottom">

      <p>
        © <%= new Date().getFullYear() %> CDSM. Tous droits réservés.
      </p>

    </div>

  </footer>


  <!-- =========================================
       JAVASCRIPT
  ========================================== -->

  <script src="/js/main.js"></script>

</body>

</html>