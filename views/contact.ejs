<!-- =========================================
     HERO CONTACT
========================================== -->

<section class="page-hero">

  <div class="container page-hero-inner">

    <p class="section-eyebrow">
      CONTACT
    </p>

    <h1>
      Parlons de votre projet
    </h1>

    <p>
      Une question, un projet numérique ou besoin d'informations
      sur nos solutions ? Contactez-nous.
    </p>

  </div>

</section>


<!-- =========================================
     CONTACT
========================================== -->

<section class="section contact-background">

  <div class="container contact-layout">


    <!-- =====================================
         INTRODUCTION
    ====================================== -->

    <div class="contact-content">

      <p class="section-eyebrow">
        CDSM
      </p>

      <h2>
        Échangeons sur vos besoins
      </h2>

      <p>
        Décrivez-nous votre projet ou les problématiques
        que vous souhaitez résoudre.
      </p>

      <p>
        Nous reviendrons vers vous afin d'étudier votre besoin
        et vous présenter les solutions adaptées.
      </p>

    </div>


    <!-- =====================================
         FORMULAIRE
    ====================================== -->

    <div class="contact-form-card">


      <!-- MESSAGE SUCCÈS -->

      <% if (typeof success !== "undefined" && success) { %>

        <div class="form-message success">
          ✓ Votre message a bien été envoyé.
        </div>

      <% } %>


      <!-- MESSAGE ERREUR -->

      <% if (typeof error !== "undefined" && error) { %>

        <div class="form-message error">
          Une erreur est survenue lors de l'envoi.
          Merci de réessayer.
        </div>

      <% } %>


      <form
        action="/contact"
        method="POST"
      >

        <div class="form-grid">


          <!-- PRÉNOM -->

          <div class="form-group">

            <label for="prenom">
              Prénom
            </label>

            <input
              type="text"
              id="prenom"
              name="prenom"
              autocomplete="given-name"
              required
            >

          </div>


          <!-- NOM -->

          <div class="form-group">

            <label for="nom">
              Nom
            </label>

            <input
              type="text"
              id="nom"
              name="nom"
              autocomplete="family-name"
              required
            >

          </div>


          <!-- SOCIÉTÉ -->

          <div class="form-group full">

            <label for="societe">
              Société
            </label>

            <input
              type="text"
              id="societe"
              name="societe"
              autocomplete="organization"
            >

          </div>


          <!-- EMAIL -->

          <div class="form-group">

            <label for="email">
              Email
            </label>

            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
            >

          </div>


          <!-- TÉLÉPHONE -->

          <div class="form-group">

            <label for="telephone">
              Téléphone
            </label>

            <input
              type="tel"
              id="telephone"
              name="telephone"
              autocomplete="tel"
            >

          </div>


          <!-- OBJET -->

          <div class="form-group full">

            <label for="objet">
              Objet
            </label>

            <input
              type="text"
              id="objet"
              name="objet"
              placeholder="Votre demande"
            >

          </div>


          <!-- MESSAGE -->

          <div class="form-group full">

            <label for="message">
              Votre message
            </label>

            <textarea
              id="message"
              name="message"
              rows="6"
              required
            ></textarea>

          </div>


          <!-- BOUTON -->

          <div class="form-group full">

            <button
              type="submit"
              class="btn btn-primary"
            >
              Envoyer le message
            </button>

          </div>

        </div>

      </form>

    </div>

  </div>

</section>


<!-- =========================================
     INFORMATIONS
========================================== -->

<section class="section section-alt">

  <div class="container">

    <div class="section-heading center">

      <p class="section-eyebrow">
        CDSM
      </p>

      <h2>
        Un interlocuteur pour vos projets numériques
      </h2>

      <p class="section-intro">
        Solutions numériques, intelligence artificielle,
        applications métier et accompagnement :
        échangeons sur vos besoins.
      </p>

    </div>

  </div>

</section>