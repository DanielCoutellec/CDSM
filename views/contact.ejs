<!-- =========================================
     HERO
========================================== -->

<section class="page-hero">

  <div class="container page-hero-inner">

    <p class="section-eyebrow">
      CONTACT
    </p>

    <h1>
      Parlons de votre projet
    </h1>

    <p>
      Une question, un projet numérique ou besoin d'informations
      sur nos solutions ? Contactez-nous.
    </p>

  </div>

</section>


<!-- =========================================
     CONTACT
========================================== -->

<section class="section">

  <div class="container contact-grid">


    <!-- INFORMATIONS -->

    <div class="contact-info">

      <p class="section-eyebrow">
        CDSM
      </p>

      <h2>
        Échangeons sur vos besoins
      </h2>

      <p>
        Décrivez-nous votre projet ou les problématiques
        que vous souhaitez résoudre.
      </p>

      <p>
        Nous reviendrons vers vous afin d'étudier votre besoin
        et vous présenter les solutions adaptées.
      </p>


      <div class="contact-points">

        <div class="contact-point">

          <div class="contact-point-icon">
            ✉️
          </div>

          <div>
            <strong>Email</strong>
            <p>Contactez notre équipe</p>
          </div>

        </div>


        <div class="contact-point">

          <div class="contact-point-icon">
            💬
          </div>

          <div>
            <strong>Votre projet</strong>
            <p>
              Décrivez votre besoin dans le formulaire.
            </p>
          </div>

        </div>


        <div class="contact-point">

          <div class="contact-point-icon">
            🤝
          </div>

          <div>
            <strong>Partenaires</strong>
            <p>
              Vous souhaitez devenir revendeur CDSM ?
              Contactez-nous également ici.
            </p>
          </div>

        </div>

      </div>

    </div>


    <!-- FORMULAIRE -->

    <div class="contact-form-card">

      <% if (success) { %>

        <div class="form-success">
          ✓ Votre message a bien été envoyé.
        </div>

      <% } %>
<% if (typeof error !== "undefined" && error) { %>
  <div class="form-error">
    Une erreur est survenue lors de l'envoi. Merci de réessayer.
  </div>
<% } %>

      <form
        action="/contact"
        method="POST"
        class="contact-form"
      >

        <div class="form-row">

          <div class="form-group">

            <label for="prenom">
              Prénom
            </label>

            <input
              type="text"
              id="prenom"
              name="prenom"
              required
            />

          </div>


          <div class="form-group">

            <label for="nom">
              Nom
            </label>

            <input
              type="text"
              id="nom"
              name="nom"
              required
            />

          </div>

        </div>


        <div class="form-group">

          <label for="societe">
            Société
          </label>

          <input
            type="text"
            id="societe"
            name="societe"
          />

        </div>


        <div class="form-group">

          <label for="email">
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            required
          />

        </div>


        <div class="form-group">

          <label for="telephone">
            Téléphone
          </label>

          <input
            type="tel"
            id="telephone"
            name="telephone"
          />

        </div>


        <div class="form-group">

          <label for="objet">
            Votre demande
          </label>

          <select
            id="objet"
            name="objet"
          >

            <option value="information">
              Informations sur les solutions
            </option>

            <option value="projet">
              Projet numérique
            </option>

            <option value="revendeur">
              Devenir revendeur
            </option>

            <option value="support">
              Assistance
            </option>

            <option value="autre">
              Autre demande
            </option>

          </select>

        </div>


        <div class="form-group">

          <label for="message">
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="7"
            required
          ></textarea>

        </div>


        <div class="form-consent">

          <input
            type="checkbox"
            id="consent"
            name="consent"
            required
          />

          <label for="consent">
            J'accepte que les informations saisies soient utilisées
            pour répondre à ma demande.
          </label>

        </div>


        <button
          type="submit"
          class="btn btn-primary contact-submit"
        >
          Envoyer ma demande
        </button>

      </form>

    </div>

  </div>

</section>